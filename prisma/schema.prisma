// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Program {
  id               String   @id
  shop             String
  name             String   @default("Cashback on every purchase")
  programType      String   @default("order")
  amount           String   @default("15")
  amountType       String   @default("Fixed amount")
  issued           String   @default("0 INR")
  budget           String   @default("Unlimited")
  status           String   @default("Active")
  startDate        String?
  startTime        String?
  endDate          String?
  endTime          String?
  enableEndDate    Boolean  @default(false)
  enableExpiration Boolean  @default(false)
  expirationType   String?
  expirationDays   String?
  expirationDate   String?
  enableDelay      Boolean  @default(false)
  delayDays        String?
  channels         String?  // JSON string
  eligibility      String?  // JSON string
  msgCart          String?
  msgProduct       String?
  notifyEmail      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Transaction {
  id           String   @id @default(uuid())
  shop         String
  orderId      String
  orderName    String
  customerId   String
  customerName String
  amount       Float
  currency     String
  status       String   @default("Completed")
  emailStatus  String   @default("Sent")
  type         String   @default("Cashback")
  createdAt    DateTime @default(now())
  issuedAt     DateTime @default(now())
}

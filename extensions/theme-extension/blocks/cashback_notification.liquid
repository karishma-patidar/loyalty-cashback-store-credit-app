<div class="loyalty-credit-app-block-container" style="display: block;">
  <div style="background-color: #FEFCE8; padding: 16px; border-radius: 8px; color: #333; margin: 15px 0; display: flex; align-items: center; gap: 15px; border: 1px solid #FEF08A; font-family: inherit; text-align: left;">
    <div style="background: #f1c40f; padding: 8px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" fill="white"/>
      </svg>
    </div>
    <div>
      <p style="margin: 0; font-size: 14px; font-weight: 500; line-height: 1.4;">
        You will receive store credit after this purchase.
      </p>
      <p style="margin: 4px 0 0; font-size: 11px; opacity: 0.7; line-height: 1;">Powered by Loyalty Credit</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Cashback Notification",
  "target": "section",
  "templates": ["customers/order", "cart", "product", "index", "page"],
  "settings": []
}
{% endschema %}

{% assign programs_metafield = shop.metafields.loyalty_cashback_app.programs.value %}
{% if programs_metafield == blank %}
  {% assign programs_metafield = shop.metafields.loyalty_cashback_app.programs %}
{% endif %}

{% assign active_program = null %}
{% for prog in programs_metafield %}
  {% if prog.status == 'Active' %}
    {% assign active_program = prog %}
    {% break %}
  {% endif %}
{% endfor %}

{% assign is_valid_schedule = false %}
{% if active_program %}
  {% assign now_ts = 'now' | date: '%s' | plus: 0 %}

  {% comment %} Start Date/Time Check {% endcomment %}
  {% assign start_valid = true %}
  {% if active_program.startDate != blank %}
    {% assign start_time_str = active_program.startTime | default: '00:00' %}
    {% assign start_combined = active_program.startDate | append: ' ' | append: start_time_str %}
    {% assign start_ts = start_combined | date: '%s' | plus: 0 %}
    {% if now_ts < start_ts %}
      {% assign start_valid = false %}
    {% endif %}
  {% endif %}

  {% comment %} End Date/Time Check (if enabled) {% endcomment %}
  {% assign end_valid = true %}
  {% if active_program.enableEndDate and active_program.endDate != blank %}
    {% assign end_time_str = active_program.endTime | default: '23:59' %}
    {% assign end_combined = active_program.endDate | append: ' ' | append: end_time_str %}
    {% assign end_ts = end_combined | date: '%s' | plus: 0 %}
    {% if now_ts > end_ts %}
      {% assign end_valid = false %}
    {% endif %}
  {% endif %}

  {% if start_valid and end_valid %}
    {% assign is_valid_schedule = true %}
  {% endif %}
{% endif %}

{% assign show_widget = true %}
{% if active_program %}
  {% if active_program.eligibility.d2c != true or is_valid_schedule == false %}
    {% assign show_widget = false %}
  {% endif %}
{% endif %}

{% assign is_preview = false %}
{% if active_program == blank %}
  {% assign is_preview = true %}
{% endif %}

{% if show_widget %}
  {% assign credit_amount_cents = 0 %}

  {% if active_program == blank %}
    {% assign credit_amount_cents = 1000 %}
  {% elsif active_program.programType == 'product' %}
    {% if request.page_type == 'product' %}
      {% comment %} Product Page: Single item calculations {% endcomment %}
      {% assign base_price = product.selected_or_first_available_variant.price | default: product.price | default: 0 %}
      {% if active_program.amountType == 'Percentage' %}
        {% assign amount_num = active_program.amount | plus: 0 %}
        {% assign calculated_cents = base_price | times: amount_num | divided_by: 100 %}

        {% if active_program.maxAmount != blank and active_program.maxAmount != '0' and active_program.maxAmount != 0 %}
          {% assign max_num = active_program.maxAmount | plus: 0 %}
          {% assign max_cents = max_num | times: 100 %}
          {% if calculated_cents > max_cents %}
            {% assign credit_amount_cents = max_cents %}
          {% else %}
            {% assign credit_amount_cents = calculated_cents %}
          {% endif %}
        {% else %}
          {% assign credit_amount_cents = calculated_cents %}
        {% endif %}
      {% else %}
        {% assign amount_num = active_program.amount | plus: 0 %}
        {% assign credit_amount_cents = amount_num | times: 100 %}
      {% endif %}
    {% else %}
      {% comment %} Cart Page: Dynamic sum per item quantity for product-based programs {% endcomment %}
      {% assign line_items = checkout.line_items | default: order.line_items | default: cart.items %}
      {% for item in line_items %}
        {% assign item_cashback_cents = 0 %}
        {% if active_program.amountType == 'Percentage' %}
          {% assign amount_num = active_program.amount | plus: 0 %}
          {% assign calculated_cents = item.price | times: amount_num | divided_by: 100 %}

          {% if active_program.maxAmount != blank
            and active_program.maxAmount != '0'
            and active_program.maxAmount != 0
          %}
            {% assign max_num = active_program.maxAmount | plus: 0 %}
            {% assign max_cents = max_num | times: 100 %}
            {% if calculated_cents > max_cents %}
              {% assign item_cashback_cents = max_cents %}
            {% else %}
              {% assign item_cashback_cents = calculated_cents %}
            {% endif %}
          {% else %}
            {% assign item_cashback_cents = calculated_cents %}
          {% endif %}
        {% else %}
          {% assign amount_num = active_program.amount | plus: 0 %}
          {% assign item_cashback_cents = amount_num | times: 100 %}
        {% endif %}

        {% assign total_item_cashback = item_cashback_cents | times: item.quantity %}
        {% assign credit_amount_cents = credit_amount_cents | plus: total_item_cashback %}
      {% endfor %}
    {% endif %}

  {% else %}
    {% comment %} Cashback by Order {% endcomment %}
    {% if active_program.amountType == 'Percentage' %}
      {% if request.page_type == 'product' %}
        {% assign base_price = product.selected_or_first_available_variant.price
          | default: product.price
          | default: 0
        %}
      {% else %}
        {% assign base_price = checkout.total_price | default: order.total_price | default: cart.total_price | default: 0 %}
      {% endif %}

      {% assign amount_num = active_program.amount | plus: 0 %}
      {% assign calculated_cents = base_price | times: amount_num | divided_by: 100 %}

      {% if active_program.maxAmount != blank and active_program.maxAmount != '0' and active_program.maxAmount != 0 %}
        {% assign max_num = active_program.maxAmount | plus: 0 %}
        {% assign max_cents = max_num | times: 100 %}
        {% if calculated_cents > max_cents %}
          {% assign credit_amount_cents = max_cents %}
        {% else %}
          {% assign credit_amount_cents = calculated_cents %}
        {% endif %}
      {% else %}
        {% assign credit_amount_cents = calculated_cents %}
      {% endif %}
    {% else %}
      {% assign amount_num = active_program.amount | plus: 0 %}
      {% assign credit_amount_cents = amount_num | times: 100 %}
    {% endif %}
  {% endif %}

  {% assign formatted_credit = credit_amount_cents | money %}

  {% assign is_thankyou = false %}
  {% if request.page_type == 'checkout' or request.page_type == 'thank_you' or template.name == 'checkout' or template.name == 'thank_you' or template.name == 'order' or template == 'checkout' or template == 'thank_you' or template == 'order' %}
    {% assign is_thankyou = true %}
  {% endif %}

  {% if request.page_type == 'product' %}
    {% assign raw_msg = active_program.msgProduct
      | default: 'Receive {loyalty_credit_amount} store credit when purchasing each item.'
    %}
  {% elsif is_thankyou %}
    {% assign raw_msg = "Thank you for your purchase! 🎉 You'll earn {loyalty_credit_amount} once your order is fulfilled. Use it on your next purchase to save more!" %}
  {% else %}
    {% assign raw_msg = active_program.msgCart
      | default: 'You will get {loyalty_credit_amount} store credit after this purchase.'
    %}
  {% endif %}

  {% comment %} --- Override message with translation from metafield --- {% endcomment %}
  {% assign translations = shop.metafields.loyalty_cashback_app.translations.value
    | default: shop.metafields.loyalty_cashback_app.translations %}
  {% if translations %}
    {% assign current_lang = request.locale.iso_code | downcase %}
    {% assign t_default_locale = translations._defaultLocale | default: 'en' %}
    {% assign t_locale = translations[current_lang] %}
    {% assign t_default = translations[t_default_locale] %}

    {% if request.page_type == 'product' %}
      {% if t_locale.cashback_msg_product != blank %}
        {% assign raw_msg = t_locale.cashback_msg_product %}
      {% elsif t_default.cashback_msg_product != blank %}
        {% assign raw_msg = t_default.cashback_msg_product %}
      {% endif %}
    {% elsif is_thankyou %}
      {% if t_locale.widget_pending_msg != blank %}
        {% assign raw_msg = t_locale.widget_pending_msg %}
      {% elsif t_default.widget_pending_msg != blank %}
        {% assign raw_msg = t_default.widget_pending_msg %}
      {% endif %}
    {% else %}
      {% if t_locale.cashback_msg_cart != blank %}
        {% assign raw_msg = t_locale.cashback_msg_cart %}
      {% elsif t_default.cashback_msg_cart != blank %}
        {% assign raw_msg = t_default.cashback_msg_cart %}
      {% endif %}
    {% endif %}
  {% endif %}

  {% capture amount_html %}<span class="loyalty-credit-amount">{{ formatted_credit }}</span>{% endcapture %}
  {% assign final_msg = raw_msg | replace: '{loyalty_credit_amount}', amount_html %}

  {% assign default_msg_prod = 'Receive {loyalty_credit_amount} store credit when purchasing each item.' %}
  {% assign escaped_msg_prod = active_program.msgProduct | default: default_msg_prod | escape %}
  {% if translations %}
    {% if t_locale.cashback_msg_product != blank %}
      {% assign escaped_msg_prod = t_locale.cashback_msg_product | escape %}
    {% elsif t_default.cashback_msg_product != blank %}
      {% assign escaped_msg_prod = t_default.cashback_msg_product | escape %}
    {% endif %}
  {% endif %}

  {% assign bg_color = shop.metafields.loyalty_cashback_app.widget_bg_color.value
    | default: shop.metafields.loyalty_cashback_app.widget_bg_color
    | default: '#FEFCE8'
  %}
  {% assign text_color = shop.metafields.loyalty_cashback_app.widget_text_color.value
    | default: shop.metafields.loyalty_cashback_app.widget_text_color
    | default: '#333333'
  %}
  {% assign credit_icon = shop.metafields.loyalty_cashback_app.widget_credit_icon.value
    | default: shop.metafields.loyalty_cashback_app.widget_credit_icon
    | default: 'icon2'
  %}
  {% assign hide_watermark = shop.metafields.loyalty_cashback_app.hide_watermark.value
    | default: shop.metafields.loyalty_cashback_app.hide_watermark
  %}

  {% assign current_bg = bg_color %}
  {% if bg_color == '#FEFCE8' %}
    {% assign current_border = '#FEF08A' %}
  {% else %}
    {% assign current_border = 'rgba(0,0,0,0.08)' %}
  {% endif %}
  {% assign current_text = text_color %}
  {% if is_thankyou %}
    {% assign current_bg = '#F4F6F8' %}
    {% assign current_border = '#E4E8EC' %}
    {% assign current_text = '#333333' %}
  {% endif %}

  <div
    class="loyalty-credit-block{% if request.page_type == 'product' %} loyalty-credit-product-block{% endif %}"
    data-page-type="{{ request.page_type }}"
    data-program-type="{{ active_program.programType | default: 'order' }}"
    data-product-price="{{ product.selected_or_first_available_variant.price | default: product.price | default: 0 }}"
    data-amount="{{ active_program.amount | default: 10 }}"
    data-amount-type="{{ active_program.amountType | default: 'Fixed amount' }}"
    data-max-amount="{{ active_program.maxAmount | default: 0 }}"
    data-msg-product="{{ escaped_msg_prod }}"
    style="background-color: {{ current_bg }}; padding: 12px; border-radius: 8px; color: {{ current_text }}; margin: 15px 0; display: {% if is_preview and request.design_mode == false %}none{% else %}flex{% endif %}; align-items: center; gap: 8px; border: 1px solid {{ current_border }}; font-family: inherit; text-align: left; width: 100%;"
  >
    <div
      class="loyalty-icon"
      style="display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 36px; height: 36px;"
    >
      {% if is_thankyou %}
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="12" cy="12" r="10" stroke="#637381" stroke-width="2" fill="none" />
          <path d="M12 11v5M12 8h.01" stroke="#637381" stroke-width="2" stroke-linecap="round" />
        </svg>
      {% elsif credit_icon == 'icon1' %}
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="12" cy="12" r="10" fill="#F59E0B" />
          <path d="M12 7l1.8 3.6 4 .6-2.9 2.8.7 4-3.6-1.9-3.6 1.9.7-4-2.9-2.8 4-.6L12 7z" fill="#FFF" />
        </svg>
      {% elsif credit_icon == 'icon3' %}
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="12" cy="12" r="10" fill="#F59E0B" />
          <circle cx="12" cy="12" r="6" stroke="#FFF" stroke-width="2" fill="none" />
        </svg>
      {% elsif credit_icon == 'icon4' %}
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="4" y="6" width="16" height="12" rx="2" stroke="#F59E0B" stroke-width="2.5" fill="none" />
          <circle cx="16" cy="12" r="2" fill="#F59E0B" />
        </svg>
      {% elsif credit_icon contains 'http' or credit_icon contains 'data:image' %}
        <img src="{{ credit_icon }}" alt="Loyalty Icon" style="width: 32px; height: 32px; object-fit: contain;">
      {% else %}
        {% comment %} Default is icon2 (dollar coin) {% endcomment %}
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="12" cy="12" r="10" fill="#F59E0B" />
          <text x="12" y="16.5" fill="#FFF" font-size="13" font-weight="bold" text-anchor="middle" font-family="sans-serif">$</text>
        </svg>
      {% endif %}
    </div>
    <div>
      <p class="loyalty-credit-content" style="margin: 0; font-size: 15px; font-weight: 500; line-height: 1.4;">
        {{ final_msg }}
      </p>
      {% if hide_watermark != 'true' and hide_watermark != true and is_thankyou == false %}
        <p style="margin: 4px 0 0; font-size: 11px; opacity: 0.7; line-height: 1;">
          Powered by
          <a href="https://getloyalty.io" target="_blank" style="color: inherit; text-decoration: underline;"
            >Getloyalty.io</a
          >
        </p>
      {% endif %}
    </div>
  </div>
{% endif %}
